# Puertos y conexión: única fuente de verdad para frontend, gateway, backend y base de datos
FRONTEND_PORT=4200
GATEWAY_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432

POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_dev_password
POSTGRES_DB=hotel
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
DATABASE_URL=postgres://hotel:hotel_dev_password@127.0.0.1:5432/hotel

# Supabase Storage S3: estas credenciales solo se usan en el backend
SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_PUBLIC_BUCKET=amanecer-public
SUPABASE_PRIVATE_BUCKET=amanecer-private

# Resend: API key and verified sender used by the backend to send email
RESEND_API_KEY=
EMAIL_FROM=
