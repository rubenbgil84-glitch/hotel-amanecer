# Puertos y conexión: única fuente de verdad para frontend, gateway, backend y base de datos
FRONTEND_PORT=4200
GATEWAY_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432

POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_dev_password
POSTGRES_DB=hotel
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
DATABASE_URL=postgres://hotel:hotel_dev_password@127.0.0.1:5432/hotel

# Resend SMTP (en local o Render). Usa una dirección de un dominio verificado en Resend.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASS=
EMAIL_FROM=Hotel Amanecer <reservas@tu-dominio-verificado.es>
HOTEL_CONTACT_EMAIL=
FRONTEND_BASE_URL=http://localhost:4200

# En Render, define HOTEL_DATA_DIR=/var/data solo si el servicio tiene disco persistente.
HOTEL_DATA_DIR=
